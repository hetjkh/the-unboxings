!.yarn/releases
!.yarn/versions

# testing
/coverage
/artifacts/catalogue/
/artifacts/luxury-source/
/artifacts/luxury-catalogue/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
public/BRAND STORY PAGE/
.tmp-pptx*/
*.tmp-pptx*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

