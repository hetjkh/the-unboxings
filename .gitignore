/whatsapp-service/

# image optimize temp map
/scripts/.image-replacements.json
/scripts/.blob-webp-replacements.json
/scripts/.blob-webp-convert.log

# Video compression backups / temp image writes
*.webm.bak
public/**/*.tmpopt
public/**/*.new
