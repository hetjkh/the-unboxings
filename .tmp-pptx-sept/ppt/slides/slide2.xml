her </a:t></a:r><a:r><a:rPr lang="en-AE" sz="1200" b="1" dirty="0"/><a:t>concept, design, materials, customization, production and packaging</a:t></a:r><a:r><a:rPr lang="en-AE" sz="1200" dirty="0"/><a:t> to create something worth remembering.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-AE" sz="1200" dirty="0"/></a:p><a:p><a:r><a:rPr lang="en-AE" sz="1200" dirty="0"/><a:t>Whether it’s 50 executive gifts or 5,000 pieces for a brand campaign, every project begins with the same question:</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-AE" sz="1200" dirty="0"/></a:p><a:p><a:r><a:rPr lang="en-AE" sz="1200" b="1" dirty="0"/><a:t>What should this gift make someone feel?</a:t></a:r><a:endParaRPr lang="en-AE" sz="1200" dirty="0"/></a:p><a:p><a:r><a:rPr lang="en-AE" sz="1200" b="1" dirty="0"/><a:t>Button:</a:t></a:r><a:r><a:rPr lang="en-AE" sz="1200" dirty="0"/><a:t> CREATE WITH US →</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-AE" sz="1200" dirty="0"/></a:p></p:txBody></p:sp><p:pic><p:nvPicPr><p:cNvPr id="5" name="Picture 4"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{B70CD803-EE4C-B3BF-2516-CCE65CF57EB5}"/></a:ext></a:extLst></p:cNvPr><p:cNvPicPr><a:picLocks noChangeAspect="1"/></p:cNvPicPr><p:nvPr/></p:nvPicPr><p:blipFill><a:blip r:embed="rId2"/><a:stretch><a:fillRect/></a:stretch></p:blipFill><p:spPr><a:xfrm><a:off x="256481" y="916684"/><a:ext cx="5839519" cy="2417326"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr></p:pic><p:cxnSp><p:nvCxnSpPr><p:cNvPr id="13" name="Straight Arrow Connector 12"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{17598A4B-3211-1911-A699-3DFEB991CA29}"/></a:ext></a:extLst></p:cNvPr><p:cNvCxnSpPr><a:cxnSpLocks/></p:cNvCxnSpPr><p:nvPr/></p:nvCxnSpPr><p:spPr><a:xfrm><a:off x="902043" y="4992414"/><a:ext cx="4100881" cy="0"/></a